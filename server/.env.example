# ==============================================================================
# NZZ Liquid Story Engine & Multimodal Studio - GCP & ADC Configuration
# ==============================================================================

# Option 1: Application Default Credentials (ADC) - Service Account Key JSON
# Place your service account JSON file in the server directory as "credentials.json"
# or set the absolute path to your credentials file here:
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# Your Google Cloud Project ID (Required for Vertex AI / Imagen 3 / Veo 2)
GCP_PROJECT_ID=your-google-cloud-project-id

# Google Cloud Region / Location (default: us-central1)
GCP_LOCATION=us-central1

# Option 2: Alternatively, if you have a Google AI Studio / Gemini API Key:
GEMINI_API_KEY=

# Cost-Saving Measures (Recommended: true)
# Uses SHA-256 disk and memory caching so repeated generations cost $0.00
ENABLE_CACHE=true

# Server Port
PORT=5001
