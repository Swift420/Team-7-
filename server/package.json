{
  "name": "data-visualisation-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Express TypeScript Backend API for Data Visualisation",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "import:articles": "tsx src/scripts/importArticles.ts",
    "backfill:countries": "tsx src/scripts/backfillCountries.ts",
    "test": "tsx --test src/services/*.test.ts"
  },
  "keywords": [
    "node",
    "express",
    "typescript",
    "data-visualization"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
