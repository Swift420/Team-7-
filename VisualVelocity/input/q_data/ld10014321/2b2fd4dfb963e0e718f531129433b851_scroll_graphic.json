    {
      "text": "Die warme Raumluft wird von einem Ventilator im Inneren der \nKlimaanlage angesaugt. ",
      "isTitle": false,
      "variants": [
        {
          "asset": {
            "key": "2026/07/09/2Artboard-184x-070e3ea73409f317a841370f12c764f0.png",
            "url": "https://nzz-q-assets2.static-nzz.ch/2026/07/09/2Artboard-184x-070e3ea73409f317a841370f12c764f0.png",
            "size": 148318,
            "type": "image/png",
            "width": 1441,
