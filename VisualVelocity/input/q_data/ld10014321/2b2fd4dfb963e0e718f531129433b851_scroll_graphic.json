            "originalName": "2Artboard 18@4x.png"
          },
          "minWidth": 0
        },
        {
          "asset": {
            "key": "2026/07/09/2Artboard-194x-f6a04d96a5caeb1ce4eea0f5164ceb7b.png",
            "url": "https://nzz-q-assets2.static-nzz.ch/2026/07/09/2Artboard-194x-f6a04d96a5caeb1ce4eea0f5164ceb7b.png",
            "size": 246751,
